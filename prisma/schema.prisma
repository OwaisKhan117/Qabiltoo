generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id                 String    @id @default(cuid())
  fullName           String
  gender             String // "male" | "female"
  age                Int
  height             String // e.g. "5 ft 6 in"
  city               String
  state              String
  country            String    @default("India")
  education          String
  profession         String
  income             String?
  maritalStatus      String // "Never Married" | "Divorced" | "Widowed"
  sect               String? // "Sunni" | "Shia" | "Just Muslim"
  religiousLevel     String? // "Very Practicing" | "Moderate" | "Exploring"
  namaz              String? // "5 times daily" | "Regularly" | "Sometimes"
  quranLevel         String? // "Hafiz" | "Reads with Tajweed" | "Reads regularly" | "Learning"
  hijabBeard         String?
  about              String
  partnerPreference  String?
  familyInfo         String?
  image              String
  photos             String    @default("[]") // JSON string array of image paths
  email              String?   @unique
  phone              String?   @unique
  isDemo             Boolean   @default(false)
  onBehalfOf         String    @default("self") // "self" | "family"
  verificationTier   String    @default("blue") // "blue" | "green" | "gold"
  trustScore         Int       @default(40) // 0-100
  tier               String    @default("Free") // Free | Silver | Gold | Platinum
  waliName           String?
  waliPhone          String?
  waliRelation       String?
  relocate           Boolean   @default(false)
  idVerified         Boolean   @default(false)
  verificationStatus String    @default("none") // none | pending | approved | rejected
  lastActive         DateTime  @default(now())
  interestsReceived  Interest[] @relation("ReceivedInterests")
  interestsSent      Interest[] @relation("SentInterests")
  viewsReceived      ProfileView[] @relation("ReceivedViews")
  viewsSent          ProfileView[] @relation("SentViews")
  messagesSent       Message[] @relation("SentMessages")
  messagesReceived   Message[] @relation("ReceivedMessages")
  savedProfiles      SavedProfile[] @relation("SavedProfiles")
  savedBy            SavedProfile[] @relation("SavedBy")
  notifications      Notification[]
  verificationRequests VerificationRequest[]
  reportsAgainst     Report[]  @relation("ReportsAgainst")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([gender])
  @@index([city])
}

model Interest {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  message   String?
  status    String   @default("pending") // pending | accepted | declined
  createdAt DateTime @default(now())
  from      Profile  @relation("SentInterests", fields: [fromId], references: [id])
  to        Profile  @relation("ReceivedInterests", fields: [toId], references: [id])

  @@index([fromId])
  @@index([toId])
}

model SavedProfile {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  createdAt DateTime @default(now())
  from      Profile  @relation("SavedProfiles", fields: [fromId], references: [id])
  to        Profile  @relation("SavedBy", fields: [toId], references: [id])

  @@unique([fromId, toId])
  @@index([fromId])
}

model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  profileId String
  createdAt DateTime @default(now())
  viewer    Profile  @relation("SentViews", fields: [viewerId], references: [id])
  profile   Profile  @relation("ReceivedViews", fields: [profileId], references: [id])

  @@index([profileId])
  @@index([viewerId])
}

model Message {
  id        String    @id @default(cuid())
  threadKey String // sorted "idA:idB" pair
  fromId    String
  toId      String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  from      Profile   @relation("SentMessages", fields: [fromId], references: [id])
  to        Profile   @relation("ReceivedMessages", fields: [toId], references: [id])

  @@index([threadKey])
  @@index([toId])
}

model SuccessStory {
  id          String   @id @default(cuid())
  coupleNames String
  title       String
  quote       String
  story       String
  image       String
  city        String
  country     String   @default("India")
  marriedAt   String
  featured    Boolean  @default(false)
  approved    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  profileId String
  type      String // proposal | match | view | message | system | verification
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model VerificationRequest {
  id         String    @id @default(cuid())
  profileId  String
  docType    String // Aadhaar | Passport | Driving Licence
  docRef     String // masked doc number
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  profile    Profile   @relation(fields: [profileId], references: [id])

  @@index([status])
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String?
  reporterName String
  profileId    String
  reason       String
  details      String?
  status       String    @default("open") // open | resolved
  action       String    @default("none") // none | warned | suspended | banned
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  profile      Profile   @relation("ReportsAgainst", fields: [profileId], references: [id])

  @@index([status])
}
